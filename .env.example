# ==============================================================================
# Server-side Gemini API Key (NEVER prefix with VITE_ so it stays server-only!)
# Copy this file to .env for local dev/preview, or add in Vercel/Cloudflare Dashboard.
# ==============================================================================
GEMINI_API_KEY=

# Rate Limit Settings (default: 20 requests per 10 minutes per IP)
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=600000

# Optional: Comma-separated allowed origins for CORS (e.g., https://yourdomain.com)
ALLOWED_ORIGIN=
